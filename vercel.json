{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": ["hkg1"],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/v1", "destination": "/api/v1" },
    { "source": "/v1/:path*", "destination": "/api/v1/:path*" }
  ]
}
